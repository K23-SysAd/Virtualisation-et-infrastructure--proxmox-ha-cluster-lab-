// /etc/bind/named.conf.local — zones faisant autorité sur infra.helios.intern (alias ns1)

// Zone directe
zone "helios.intern" {
    type primary;
    file "/etc/bind/zones/db.helios.intern";
    allow-update { none; };
};

// Zone inverse 192.168.100.0/24
zone "100.168.192.in-addr.arpa" {
    type primary;
    file "/etc/bind/zones/db.192.168.100";
    allow-update { none; };
};
