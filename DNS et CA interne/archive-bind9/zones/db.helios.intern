; Zone directe helios.intern
; IMPORTANT : incrémenter le numéro de série à chaque modification (AAAAMMJJNN).
$TTL 3600
$ORIGIN helios.intern.

@       IN  SOA ns1.helios.intern. hostmaster.helios.intern. (
            2026111201  ; serial
            3600        ; refresh
            900         ; retry
            1209600     ; expire (14 jours)
            300 )       ; negative TTL

; Serveurs de noms
@               IN  NS      ns1.helios.intern.

; Messagerie
@               IN  MX  10  mail.helios.intern.

; --- Infrastructure : DNS + CA sur la même VM Linux ---
infra           IN  A       192.168.100.11
ns1             IN  A       192.168.100.11   ; cible du NS : un A, jamais un CNAME
ca              IN  A       192.168.100.11

; --- Serveurs applicatifs ---
mail            IN  A       192.168.100.10
odoo            IN  A       192.168.100.20

; --- Postes ---
client          IN  A       192.168.100.30

; --- Alias applicatifs ---
webmail         IN  CNAME   mail
erp             IN  CNAME   odoo
acme            IN  CNAME   ca
